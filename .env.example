# Transport ANCF — Variables d'environnement
# Copier ce fichier en .env et adapter les valeurs

# JWT
JWT_PASSPHRASE=change_me_in_production

# API Île-de-France Mobilités (optionnel — données mock si vide)
# Obtenez une clé sur https://prim.iledefrance-mobilites.fr/
IDFM_API_KEY=

# MySQL (pour production)
MYSQL_ROOT_PASSWORD=change_root_password
MYSQL_DATABASE=ancf_transport
MYSQL_USER=ancf_user
MYSQL_PASSWORD=change_user_password

# Backend (pour production — docker-compose.prod.yml) : mêmes identifiants que ci-dessus,
# host "mysql" (nom du service dans le réseau Docker, pas 127.0.0.1)
DATABASE_URL=mysql://ancf_user:change_user_password@mysql:3306/ancf_transport?serverVersion=8.0&charset=utf8mb4

# Docker Hub (pour production — docker-compose.prod.yml) : namespace et version des images
# à déployer. Doit correspondre au compte utilisé par la CD (secrets.DOCKERHUB_USERNAME).
DOCKER_IMAGE_PREFIX=votre_pseudo_dockerhub
VERSION=v1.0.3

# Redis (cache applicatif en prod). Chez un hébergeur PaaS, utiliser l'URL de l'add-on.
REDIS_URL=redis://redis:6379

# CORS (URL du frontend en production)
# Frontend hébergé sur Vercel : ^https://.*\.vercel\.app$ (ou le domaine exact)
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$

# Frontend
VITE_API_URL=http://localhost:8080/api

# Docker Hub (pour CD)
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
