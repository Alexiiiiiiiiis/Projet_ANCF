# Template d'environnement — copier en .env et adapter les valeurs.
# En Docker, ces valeurs sont fournies par docker-compose (variables d'environnement).

APP_ENV=dev
APP_SECRET=!ChangeMe!

# MySQL
DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/ancf_transport?serverVersion=8.0&charset=utf8mb4"

# JWT (générer les clés : php bin/console lexik:jwt:generate-keypair)
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=!ChangeMe!

# Redis — cache applicatif en prod (cf. config/packages/prod/cache.php).
# Laissé vide volontairement : c'est le déploiement qui déclare son Redis s'il en a un
# (docker-compose.prod.yml, scripts/demo-publique.sh, variables d'un PaaS). Une valeur par
# défaut ici ferait croire au code qu'un Redis existe partout, y compris sur un hébergement
# mutualisé qui n'en propose pas — l'application y refuserait alors de démarrer.
REDIS_URL=

# API Île-de-France Mobilités (optionnel — données mock si vide)
# Obtenir une clé : https://prim.iledefrance-mobilites.fr/
IDFM_API_KEY=

# Mailer (null en dev, SMTP réel en prod)
MAILER_DSN=null://null
FRONTEND_URL=http://localhost:5173

# CORS
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# Routing (URLs en contexte CLI)
DEFAULT_URI=http://localhost
